# ============================================================
# 打包时注入 zip 的 Claude 连接配置模板
# 用法：复制本文件为 desktop.env，填好值后运行 build-win.ps1
#   Copy-Item scripts\release\desktop.env.template scripts\release\desktop.env
# desktop.env 已加入 .gitignore，真实密钥不会进入仓库。
#
# 也可以不建文件，改为在构建机设置环境变量 RDCLI_DESKTOP_ENV，
# 值即本文件内容；desktop.env 文件存在时优先于环境变量。
#
# 注意：
# - 注入位置是 zip 内的 resources\app\.env，明文保存，拿到安装包的人
#   都能看到密钥。请使用共享/有限额密钥，不要放个人生产密钥。
# - 用户重新解压新版本 zip 会覆盖该文件（若用户自行修改过 .env）。
# - 用户自己设置的系统环境变量优先级高于本文件（load-env 不覆盖已有值）。
# - '#' 开头的行为注释；等号分隔键值，值内不要包含注释。
# ============================================================

# -----------------------------------------------------------------
# 连接配置（国内环境必填）
# -----------------------------------------------------------------

# 中转/代理网关地址（Claude Code 默认直连 claude.com，国内不可达）
ANTHROPIC_BASE_URL=https://your-gateway.example.com

# 密钥（API Key 与 Auth Token 二选一即可）
ANTHROPIC_API_KEY=sk-your-key-here
# ANTHROPIC_AUTH_TOKEN=your-auth-token-here

# -----------------------------------------------------------------
# 模型配置
# -----------------------------------------------------------------

# 默认模型
ANTHROPIC_MODEL=deepseek-v4-pro

# 各档位默认模型（按需设置，不设则用 ANTHROPIC_MODEL 或 Claude Code 内置值）
ANTHROPIC_DEFAULT_OPUS_MODEL=deepseek-v4-pro
ANTHROPIC_DEFAULT_SONNET_MODEL=deepseek-v4-pro
ANTHROPIC_DEFAULT_HAIKU_MODEL=deepseek-v4-flash

# 子任务模型（Claude Code 内部调用子任务时使用的模型，轻量模型可显著节省 token）
CLAUDE_CODE_SUBAGENT_MODEL=deepseek-v4-flash

# -----------------------------------------------------------------
# 行为配置
# -----------------------------------------------------------------

# 推理强度：low | medium | high | xhigh | max（默认 high）
CLAUDE_CODE_EFFORT_LEVEL=max

# API 超时（毫秒），默认 600000（10 分钟）
API_TIMEOUT_MS=600000

# 禁用非必要网络流量（如遥测、更新检查等），国内环境建议开启
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1

# 禁用归因头（避免额外的 HTTP 请求）
CLAUDE_CODE_ATTRIBUTION_HEADER=0