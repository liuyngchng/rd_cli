# ============================================================
# 打包时注入 zip 的 Pi 配置模板
# 用法：复制本文件为 desktop.env，填好值后运行 build-win.ps1
#   Copy-Item scripts\release\desktop.env.template scripts\release\desktop.env
# desktop.env 已加入 .gitignore，真实密钥不会进入仓库。
#
# 也可以不建文件，改为在构建机设置环境变量 RDCLI_DESKTOP_ENV，
# 值即本文件内容；desktop.env 文件存在时优先于环境变量。
#
# 注意：
# - 注入位置是 zip 内的 resources\app\.pi-auth.json，明文保存，拿到安装包
#   的人都能看到密钥。请使用共享/有限额密钥，不要放个人生产密钥。
# - 用户重新解压新版本 zip 会覆盖该文件。
# - 用户自己设置的 ~/.pi/agent/auth.json 优先级高于本文件。
# - '#' 开头的行为注释；等号分隔键值，值内不要包含注释。
# ============================================================

# Pi 的 API Key 配置（用于调用大模型）
# 说明：Pi 不像 Claude Code 用环境变量，而是把密钥存在 ~/.pi/agent/auth.json 里。
# 打包时若提供了下面的 PI_API_KEY，构建脚本会把它写成一个初始 auth.json。
# 用户也可以在应用内用 `pi auth` 自行配置。

# 大模型 provider（deepseek / qwen / glm / openai / anthropic 等）
PI_DEFAULT_PROVIDER=deepseek

# 对应 provider 的 API Key
PI_API_KEY=sk-your-key-here

# 可选：API base URL（使用中转/代理网关时设置；不设则用 provider 默认地址）
PI_BASE_URL=https://your-gateway.example.com

# 可选：默认模型（不设则用 provider 默认模型）
PI_DEFAULT_MODEL=deepseek-chat
